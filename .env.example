# Signing key for the subscribe and unsubscribe confirmation links, and for cron auth.
CRON_SECRET=

# Newsletter. Without these the site runs fine and the subscribe form quietly no-ops.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_WEBHOOK_SECRET=      # open and click events -> /api/resend-webhook
RESEND_INBOUND_SECRET=      # mail to hello@ -> /api/inbound
CONTACT_FORWARD_TO=         # where inbound mail is forwarded
REDIS_URL=                  # rate limits and the open/click counters

# Writing the quarterly letter. Only needed to build an issue, never at runtime.
ANTHROPIC_API_KEY=
NEWSLETTER_MODEL=           # defaults to claude-fable-5
