# Public receiving address only. Never place its private key on this server.
X402_PAY_TO=
# Base Sepolia preview default; Base mainnet is eip155:8453.
X402_NETWORK=eip155:84532
# Optional HTTPS facilitator override. Defaults: x402.org testnet / CDP mainnet.
# X402_FACILITATOR_URL=https://x402.org/facilitator
# For Coinbase's mainnet facilitator only (server credentials, never client API keys):
# CDP_API_KEY_ID=
# CDP_API_KEY_SECRET=
# Existing shared Redis is required for durable payment idempotency on Vercel.
# REDIS_URL=
# Vercel logs use Blob, local development writes .agent-api/usage.jsonl.
# BLOB_READ_WRITE_TOKEN=
# Existing public Blob store supports non-sensitive route/amount/transaction logs.
# Set private only when using a private Blob store.
# X402_BLOB_ACCESS=private
# For optional paid preview check only; existing funded buyer's Base Sepolia key.
# TEST_PAYER_KEY=
